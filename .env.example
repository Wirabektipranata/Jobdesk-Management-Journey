# ==================================================
# JOURNEYFX WORKSPACE
# Internal Jobdesk & Project Management System
# Version 1.0.0
# Environment Configuration Template
# ==================================================


# ==================================================
# 01. SUPABASE DATABASE CONFIGURATION
# ==================================================

# Supabase Project URL
VITE_SUPABASE_URL=

# Supabase Publishable Key or Legacy Anon Key
VITE_SUPABASE_ANON_KEY=


# ==================================================
# 02. APPLICATION IDENTITY
# ==================================================

VITE_APP_NAME="JourneyFX Workspace"
VITE_APP_VERSION="1.0.0"
VITE_APP_URL=
VITE_APP_ENV="development"


# ==================================================
# 03. ORGANIZATION CONFIGURATION
# ==================================================

VITE_ORGANIZATION_NAME="JourneyFX"
VITE_APP_TIMEZONE="Asia/Jakarta"
VITE_APP_LOCALE="id-ID"


# ==================================================
# 04. DEVELOPMENT CONFIGURATION
# ==================================================

VITE_DEMO_MODE=true


# ==================================================
# 05. FEATURE CONFIGURATION
# ==================================================

VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_REPORT_EXPORT=true


# ==================================================
# 06. SECURITY NOTICE
# ==================================================

# Never expose Supabase service_role keys.
# Never expose Supabase secret keys.
# Never expose database passwords.
# Never commit .env or .env.local files.
# All VITE_ variables are accessible to the frontend.
# Database security must be enforced through RLS.


# ==================================================
# JOURNEYFX WORKSPACE
# One Team. One Workspace. One Direction.
# ==================================================
